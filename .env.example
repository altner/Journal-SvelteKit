# SQLite database file (libsql). For local dev, a relative file path is fine.
DATABASE_URL=file:local.db

# Where uploaded photos are stored on disk (created automatically).
UPLOAD_DIR=./uploads

# Required by @sveltejs/adapter-node in production (your public URL).
ORIGIN=http://localhost:3000

# Increase from the 512kb default so photo/GPX uploads aren't rejected. Activity uploads combine
# a GPX track with multiple original (unresized) photos in one request — observed real-world
# uploads already hit ~48M, so 20M was too tight.
BODY_SIZE_LIMIT=100M

# Micropub-style endpoints (routes/api/micropub/{checkin,post,album}) — for your own Apple
# Shortcuts, not a general Micropub/IndieAuth client. Same token/owner shared by all three.
# MICROPUB_TOKEN is a long random secret sent as `Authorization: Bearer <token>`; generate one
# with e.g. `openssl rand -hex 32`. MICROPUB_USER_EMAIL picks which account owns whatever's
# created through them.
MICROPUB_TOKEN=
MICROPUB_USER_EMAIL=

