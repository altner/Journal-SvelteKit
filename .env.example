# SQLite database file (libsql). For local dev, a relative file path is fine.
DATABASE_URL=file:local.db

# Where uploaded photos are stored on disk (created automatically).
UPLOAD_DIR=./uploads

# Required by @sveltejs/adapter-node in production (your public URL).
ORIGIN=http://localhost:3000

# Increase from the 512kb default so photo/GPX uploads aren't rejected. Activity uploads combine
# a GPX track with multiple original (unresized) photos in one request — observed real-world
# uploads already hit ~48M, so 20M was too tight.
BODY_SIZE_LIMIT=100M

# Micropub-style endpoints routes/api/micropub/{post,album} — MICROPUB_TOKEN is a long random
# secret sent as `Authorization: Bearer <token>`; generate one with e.g. `openssl rand -hex 32`.
# routes/api/micropub/album only ever accepts this static token (your own Apple Shortcuts).
# routes/api/micropub/post accepts this static token too, but falls back to IndieAuth
# introspection (see INDIEAUTH_* below) if it doesn't match — that's what lets a real
# IndieAuth/Micropub client (e.g. the separate Quill editor) post without ever seeing this secret.
# NOTE: routes/api/micropub/checkin doesn't use this at all — see INDIEAUTH_* below.
MICROPUB_TOKEN=

# The one owner account everything (Micropub-created content, and now the website login itself)
# gets attributed to. Must match the email of a user row created via `npm run create-user`.
MICROPUB_USER_EMAIL=

# External IndieAuth server (see /Users/adrian/Projects/indie-auth) used for BOTH: (1)
# server-to-server Bearer-token introspection for routes/api/micropub/{checkin,post}, and (2) the
# actual browser login flow at /login (src/lib/server/indieAuthLogin.ts) — logging into the
# website itself now redirects here instead of checking a local password.
# INDIEAUTH_INTROSPECT_URL / INDIEAUTH_AUTHORIZATION_ENDPOINT / INDIEAUTH_TOKEN_ENDPOINT are that
# server's /introspect, /auth, and /token endpoints. INDIEAUTH_ME is the exact `me` identity URL
# that must match — rejects tokens/logins for a different identity on the same IndieAuth server.
INDIEAUTH_INTROSPECT_URL=http://localhost:8080/introspect
INDIEAUTH_AUTHORIZATION_ENDPOINT=http://localhost:8080/auth
INDIEAUTH_TOKEN_ENDPOINT=http://localhost:8080/token
INDIEAUTH_ME=http://localhost:8080/identities/adrian

